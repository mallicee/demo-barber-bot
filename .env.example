# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env НЕ попадает в git (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: запустите бота и отправьте ему /id).
# Можно оставить пустым при первом запуске.
ADMIN_ID=

# Часовой пояс барбершопа (необязательно, по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow
